{
  "name": "ielyssa-personal-website",
  "version": "4.0.0",
  "private": true,
  "description": "Personal website of IRANKUNDA Elyssa — Founder & CEO of ATAS. Next.js App Router, MUI, MDX content layer.",
  "author": "IRANKUNDA Elyssa",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/generate-og.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/**/*.{ts,mdx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"content/**/*.{ts,mdx}\" \"scripts/*.mjs\"",
    "media": "node scripts/prep-media.mjs",
    "og": "node scripts/generate-og.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@iconify/react": "^5.2.1",
    "@mui/material": "^7.0.1",
    "@mui/material-nextjs": "^7.0.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "dayjs": "^1.11.13",
    "gray-matter": "^4.0.3",
    "next": "^15.3.2",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reading-time": "^1.5.0",
    "resend": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.2",
    "prettier": "^3.5.3",
    "sharp": "^0.34.1",
    "typescript": "^5.8.2",
    "vitest": "^3.1.2"
  }
}
